{
  "version": 2,
  "builds": [
    {
      "src": "tu_proyecto/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "staticfiles/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "staticfiles/$1"
    },
    {
      "src": "(.*)",
      "dest": "tu_proyecto/wsgi.py"
    }
  ]
}
